# Copy to .env.prod, then:
#
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up --build -d
#
# Short, because there are no secrets: no database, and no API keys — the
# basemap comes from OpenFreeMap, which needs none.

# Host port nginx binds to. Put TLS in front of it — your platform's load
# balancer, or Caddy — rather than terminating it in the container.
PUBLIC_PORT=80

# Which interface that port is published on. 127.0.0.1 when a TLS proxy on the
# same host sits in front; otherwise the plain-HTTP port is reachable from
# outside past ufw, because Docker writes its own iptables rules.
# PUBLIC_BIND_ADDRESS=0.0.0.0

# Uploads per visitor per minute. Clustering is CPU work on the request.
UPLOADS_PER_MINUTE=20
